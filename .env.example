# Public client configuration only. These values are safe placeholders, not credentials.
# The current TaskFlow app does not connect to Supabase yet.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Do not add a service-role key or AI provider secret to a VITE_* variable.
# Server-side integrations require a trusted server/edge function, which is not
# currently part of this frontend-only project.
